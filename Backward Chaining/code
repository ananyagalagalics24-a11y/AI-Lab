facts = {"infection", "Sore throat"}

rules = [
    (["infection"], "fever"),
    (["Sore throat"], "cough"),
    (["fever", "cough"], "flu")
]

def backward_chaining(goal, facts, rules):
    if goal in facts:
        return True

    for conditions, conclusion in rules:
        if conclusion == goal:
            if all(backward_chaining(c, facts, rules)
                   for c in conditions):
                return True

    return False


goal = "flu"

if backward_chaining(goal, facts, rules):
    print("Query", goal, "is proved")
else:
    print("Query", goal, "is not proved")
