import random

N = 8

# Calculate attacking queen pairs
def heuristic(board):
    conflicts = 0

    for i in range(N):
        for j in range(i + 1, N):

            # Same row OR same diagonal
            if (board[i] == board[j] or
                abs(board[i] - board[j]) == abs(i - j)):

                conflicts += 1

    return conflicts


# Hill Climbing with Random Restart
def hill_climbing():

    while True:

        # Generate random initial state
        board = [random.randint(0, N - 1) for _ in range(N)]

        while True:

            current_h = heuristic(board)

            # Check goal state
            if current_h == 0:
                return board

            best_h = current_h
            best_neighbors = []

            # Generate all neighbouring states
            for col in range(N):
                for row in range(N):

                    if row == board[col]:
                        continue

                    new_board = board[:]
                    new_board[col] = row

                    h = heuristic(new_board)

                    if h < best_h:
                        best_h = h
                        best_neighbors = [new_board]

                    elif h == best_h and h < current_h:
                        best_neighbors.append(new_board)

            # Local minimum: restart
            if best_h >= current_h:
                break

            # Choose randomly among equally good neighbours
            board = random.choice(best_neighbors)


# Display chessboard
solution = hill_climbing()

print("Solution Found:\n")

for row in range(N):
    for col in range(N):

        if solution[col] == row:
            print("Q", end=" ")
        else:
            print(".", end=" ")

    print()

print("Heuristic Value:", heuristic(solution))
