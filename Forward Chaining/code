facts = {"infection", "Sore throat"}

rules = [
    (["infection"], "fever"),
    (["Sore throat"], "cough"),
    (["fever", "cough"], "flu")
]

def forward_chaining(facts, rules):
    facts = set(facts)

    while True:
        new_fact = False

        for conditions, conclusion in rules:
            if all(c in facts for c in conditions):
                if conclusion not in facts:
                    facts.add(conclusion)
                    print("Derived:", conclusion)
                    new_fact = True

        if not new_fact:
            break

    return facts


result = forward_chaining(facts, rules)

print("Final Facts:", sorted(result))

if "flu" in result:
    print("Query flu is proved")
else:
    print("Query flu is not proved")
